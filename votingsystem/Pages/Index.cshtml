@page
@model IndexModel //homepage
@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Draft</title>
    <link rel="stylesheet" href="/css/login.css" />
    <script defer src="/js/login.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
</head>
<body>
    <div class="wrapper">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert">
                @Model.Message
            </div>
        }
        <div class="title"><span>Voting System</span></div>
        <form method="post" asp-page-handler="LoginAsync">
            @Html.AntiForgeryToken()
            <div class="row">
                <i class="fas fa-user"></i>
                <input type="text" asp-for="UserName" placeholder="UserName" aria-label="UserName" required />
            </div>
            <div class="row">
                <i class="fas fa-lock"></i>
                <input type="password" asp-for="Password" placeholder="Password" aria-label="Password" required />
            </div>
            <div class="button">
                <input type="submit" value="Login" />
            </div>
        </form>
        <form method="post" asp-page-handler="RedirectToForgotPassword">
            @Html.AntiForgeryToken()
            <button type="submit">Forgot password?</button>
        </form>
        <form method="post" asp-page="Registration">
            <button type="submit">Sign up here</button>
        </form>
    </div>
</body>
</html>
