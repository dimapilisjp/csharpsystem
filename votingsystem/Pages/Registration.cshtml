@page
@model votingsystem.Pages.RegistrationModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Voting System - Register</title>
    <link rel="stylesheet" href="/css/Registration.css">
    <script defer src="/js/Registration.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="wrapper">
        <div class="title">Create an Account</div>
        <form method="post">
            <div class="row">
                <i class="fas fa-user"></i>
                <input type="text" id="firstname" name="FirstName" placeholder="First Name" required>
            </div>
            <div class="row">
                <i class="fas fa-user"></i>
                <input type="text" id="lastname" name="LastName" placeholder="Last Name" required>
            </div>
            <div class="row">
                <i class="fas fa-envelope"></i>
                <input type="email" id="email" name="Email" placeholder="Email Address" required>
            </div>
            <div class="row">
                <i class="fas fa-map-marker-alt"></i>
                <input type="text" id="address" name="Address" placeholder="Address" required>
            </div>
            <div class="row">
                <i class="fas fa-user"></i>
                <input type="text" id="username" name="UserName" placeholder="Username" required>
            </div>
            <div class="row">
                <i class="fas fa-lock"></i>
                <input type="password" id="password" name="PasswordHash" placeholder="Password" required>
            </div>
            <div class="row">
                <i class="fas fa-calendar"></i>
                <div class="birthdate">
                    <select id="month" name="month">
                        <option value="" selected disabled>Month</option>
                        <option>January</option>
                        <option>February</option>
                        <option>March</option>
                        <option>April</option>
                        <option>May</option>
                        <option>June</option>
                        <option>July</option>
                        <option>August</option>
                        <option>September</option>
                        <option>October</option>
                        <option>November</option>
                        <option>December</option>
                    </select>
                    <select id="day" name="day">
                        <option value="" selected disabled>Day</option>
                        <script>for (let i = 1; i <= 31; i++) document.write(`<option>${i}</option>`);</script>
                    </select>
                    <select id="year" name="year">
                        <option value="" selected disabled>Year</option>
                        <script>for (let i = new Date().getFullYear(); i >= 1950; i--) document.write(`<option>${i}</option>`);</script>
                    </select>
                </div>
            </div>
            <div class="row button">
                <input type="submit" value="Register">
            </div>
        </form>
        <p class="back-link">
            Already have an account?
            <form method="post" asp-page-handler="RedirectToLogin" style="display: inline;">
                <button type="submit" class="back-button">Go back to Login</button>
            </form>
        </p>

    </div>
</body>
</html>

