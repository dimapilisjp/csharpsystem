@page
@model votingsystem.Pages.Shared.UPMyBallotsModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Ballots</title>
    <link rel="stylesheet" href="/css/UPMyBallots.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <header class="header-bar">
        <div class="logo">VotingSystem</div>
        <nav class="nav-links">
            <form method="post" asp-page-handler="RedirectToHome">
                <button type="submit" class="ballot-button">
                    <i class="fas fa-home"></i> Home
                </button>
            </form>
            <form method="post" asp-page-handler="RedirectToBallot">
                <button type="submit" class="ballot-button">
                    <i class="fas fa-list-alt"></i> My Ballots
                </button>
            </form>
            <form method="post" asp-page-handler="RedirectToResults">
                <button type="submit" class="results-button">
                    <i class="fas fa-chart-bar"></i> Results
                </button>
            </form>
            <form method="post" asp-page-handler="Logout">
                <button type="submit" class="logout-button" onclick="return confirm('Are you sure you want to log out?');">
                    <i class="fas fa-sign-out-alt"></i> Log Out
                </button>
            </form>
        </nav>
    </header>

    <main class="main-content">
        <section class="dashboard-section">
            <h2>My Ballots</h2>
            <div id="ballots-container">
                @if (Model.VotedElections.Any())
                {
                    @foreach (var election in Model.VotedElections)
                    {
                        <div class="election-card">
                            <h3>@election.Title</h3>
                            <p><strong>Election Period:</strong> @election.StartTime.ToString("MMM dd, yyyy") - @election.EndTime.ToString("MMM dd, yyyy")</p>

                            <form method="post" asp-page-handler="ShowBallot">
                                <input type="hidden" name="electionId" value="@election.ElectionId">
                                <button type="submit" class="ballot-button">
                                    <i class="fas fa-list-alt"></i> Show Ballot
                                </button>
                            </form>
                        </div>
                    }
                }
                else
                {
                    <p>You have not voted in any elections yet.</p>
                }
            </div>
        </section>
    </main>
</body>
</html>
