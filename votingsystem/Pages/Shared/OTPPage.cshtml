@page
@model votingsystem.Pages.Shared.OTPPageModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Verify OTP</title>
    <link rel="stylesheet" href="~/css/OTPPage.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet" />
</head>
<body>
    <div class="otp-container">
        <div class="otp-card">
            <h2>Verify Your Email</h2>
            <p>A One-Time Password (OTP) has been sent to the email you have entered. Please enter it below to complete registration.</p>
            <form method="post" asp-page-handler="Verify">
                <label for="otp">Enter OTP</label>
                <input type="number" id="otp" name="OtpCode" maxlength="6" required onkeypress="return event.charCode >= 48 && event.charCode<= 57" />
                <button type="submit">Verify OTP</button>
            </form>
            @* <form method="post" asp-page-handler="Resend"> *@
            @*     <button type="submit" class="resend-button">Resend OTP</button> *@
            @* </form> *@
        </div>
    </div>
</body>
</html>

