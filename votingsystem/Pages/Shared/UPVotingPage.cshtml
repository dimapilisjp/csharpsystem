@page
@model votingsystem.Pages.Shared.VotingPageModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vote Now</title>
    <link rel="stylesheet" href="/css/UPVotingPage.css">
    <script defer src="/js/UPVotingPage.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <header class="header-bar">
        <div class="logo">VotingSystem</div>
        <nav class="nav-links">
            <form method="post" asp-page-handler="RedirectToHome">
                <button type="submit" class="ballot-button">
                    <i class="fas fa-home"></i> Home
                </button>
            </form>
            <form method="post" asp-page-handler="RedirectToBallot">
                <button type="submit" class="ballot-button">
                    <i class="fas fa-list-alt"></i> My Ballots
                </button>
            </form>
            <form method="post" asp-page-handler="RedirectToResults">
                <button type="submit" class="results-button">
                    <i class="fas fa-chart-bar"></i> Results
                </button>
            </form>
            <form method="post" asp-page-handler="Logout">
                <button type="submit" class="logout-button" onclick="return confirm('Are you sure you want to log out?');">
                    <i class="fas fa-sign-out-alt"></i> Log Out
                </button>
            </form>
        </nav>
    </header>

    <main class="main-content">
        <section class="dashboard-section">
            <form method="post" asp-page-handler="CastVote">
                <input type="hidden" asp-for="ElectionId" />
                <input type="hidden" name="electionId" value="@Model?.Election?.ElectionId ?? 0">
                <input type="hidden" name="UserId" value="@Model?.UserId ?? 0" />
                @if (Model?.Candidates != null && Model.Candidates.Any())
                {
                    var groupedCandidates = Model.Candidates.GroupBy(c => c.Position);

                    foreach (var group in groupedCandidates)
                    {
                        <div class="position-group">
                            <h2 class="section-title">Candidates for @group.Key</h2>
                            <div class="candidate-container">
                                @foreach (var candidate in group)
                                {
                                    <div class="candidate-card">
                                        <label>
                                            <img class="candidate-photo" src="@candidate.PictureUrl" alt="@candidate.Name" />
                                            <h3>@candidate.Name</h3>
                                            <div class="candidate-info">
                                                <p><strong>Party:</strong> @candidate.PartyList</p>
                                                <p><strong>Address:</strong> @candidate.Address</p>
                                            </div>
                                            <input type="radio" id="candidate-@candidate.Id" name="selectedCandidates[@group.Key]" value="@candidate.Id">
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>No candidates available for this election.</p>
                }
                <button type="submit" class="vote-button" onclick="return confirm('Are you sure you want to submit your vote?')">Submit Vote</button>
            </form>
        </section>
    </main>
</body>
</html>
