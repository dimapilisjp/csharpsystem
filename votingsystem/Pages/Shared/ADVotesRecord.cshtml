@page
@model votingsystem.Pages.Shared.ADVotesRecordModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Votes Record</title>
    <link rel="stylesheet" href="/css/ADVotesRecord.css">
    <script defer src="/js/ADVotesRecord.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="wrapper">
        <nav class="sidebar">
            <ul>
                <li>
                    <form method="post" asp-page-handler="RedirectToDashboard">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-chart-line"></i> Dashboard
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToManageElections">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-vote-yea"></i> Manage Elections
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToManageCandidates">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-users"></i> Manage Candidates
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToManageVoters">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-users"></i> Manage Voters
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToVotesRecord">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-list-alt"></i> Votes Record
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToElectionsData">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-chart-line"></i> Elections Data
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToResults">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-chart-bar"></i> Results
                        </button>
                    </form>
                </li>
            </ul>
            <div class="bottom-icon">
                <form method="post" asp-page-handler="LogOut">
                    <button type="submit" class="logout-button">
                        <i class="fas fa-sign-out-alt"></i> Log Out
                    </button>
                </form>
            </div>
        </nav>
        <div class="main-content">
            <header>
                <h1>Votes Record</h1>
                <input type="text" id="search-votes" placeholder="Search voter history" />
            </header>

            <section class="votes-table">
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Vote ID</th>
                                <th>User</th>
                                <th>Election</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vote in Model.VoteHistories)
                            {
                                <tr>
                                    <td>@vote.VoteId</td>
                                    <td>@vote.UserName</td>
                                    <td>@vote.ElectionId</td>
                                    <td>
                                        <form method="get" asp-page="/Shared/ADViewBallot">
                                            <input type="hidden" name="userId" value="@vote.UserId">
                                            <input type="hidden" name="electionId" value="@vote.ElectionId">
                                            <button type="submit" class="view-ballot-button">
                                                View Ballot
                                            </button>
                                        </form>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section id="ballot-details" class="hidden">
                <h2>Vote Receipt</h2>
                <p><strong>Election:</strong> <span id="receipt-election-title"></span></p>
                <div id="voted-container"></div>
            </section>
        </div>
    </div>
</body>
</html>



