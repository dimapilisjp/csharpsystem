@page
@model votingsystem.Pages.Shared.ADManageVotersModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Manage Voters</title>
    <link rel="stylesheet" href="/css/ADManageVoters.css">
    <script defer src="/js/ADManageVoters.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="wrapper">
        <nav class="sidebar">
            <ul>
                <li>
                    <form method="post" asp-page-handler="RedirectToDashboard">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-chart-line"></i> Dashboard
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToManageElections">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-vote-yea"></i> Manage Elections
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToManageCandidates">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-users"></i> Manage Candidates
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToManageVoters">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-users"></i> Manage Voters
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToVotesRecord">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-list-alt"></i> Votes Record
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToElectionsData">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-chart-line"></i> Elections Data
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToResults">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-chart-bar"></i> Results
                        </button>
                    </form>
                </li>
            </ul>
            <div class="bottom-icon">
                <form method="post" asp-page-handler="LogOut">
                    <button type="submit" class="logout-button">
                        <i class="fas fa-sign-out-alt"></i> Log Out
                    </button>
                </form>
            </div>
        </nav>
        <div class="main-content">
            <header>
                <h1>Manage Voters</h1>
                <input type="text" id="search-voters" placeholder="Search voters" />
            </header>
            <section class="voter-table">
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th>Username</th>
                                <th>Age</th>
                                <th>Department</th>
                                <th>Program</th>
                                <th>School ID/Certificate of Registration</th>
                                <th>Approval Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var voter in Model.Voters)
                            {
                                <tr>
                                    <td>@voter.Id</td>  
                                    <td>@voter.FirstName</td>
                                    <td>@voter.LastName</td>
                                    <td>@voter.Email</td>
                                    <td>@voter.Address</td>
                                    <td>@voter.UserName</td>
                                    <td>@voter.Age</td>
                                    <td>@voter.Department</td>
                                    <td>@voter.Program</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(voter.PhotoPath))
                                        {
                                            <a href="@voter.PhotoPath" target="_blank">
                                                <img src="@voter.PhotoPath" alt="Voter Photo" style="max-width: 100px; max-height: 100px; cursor: pointer;" />
                                            </a>
                                        }
                                        else
                                        {
                                            <span>No Photo Uploaded</span>
                                        }
                                    </td>
                                    <td>
                                        @if (voter.IsApproved)
                                        {
                                            <span class="approved-status">Approved</span>
                                        }
                                        else
                                        {
                                            <span class="pending-status">Pending Approval</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!voter.IsApproved)
                                        {
                                            <form method="post" asp-page-handler="ApproveVoter" asp-route-id="@voter.Id" onsubmit="return confirmApproval('@voter.FirstName', '@voter.LastName')">
                                                <button type="submit" class="approve-button">Approve</button>
                                            </form>
                                            <form method="post" asp-page-handler="RejectVoter" asp-route-id="@voter.Id" onsubmit="return confirmRejection('@voter.FirstName', '@voter.LastName')">
                                                <button type="submit" class="reject-button">Reject</button>
                                            </form>
                                        }
                                        <form method="post" asp-page-handler="DeleteVoter" asp-route-id="@voter.Id" onsubmit="return confirmDeletion('@voter.Id')">
                                            <button type="submit" class="delete-button">Delete</button>
                                        </form>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</body>
</html>


