@page "{handler?}/{id?}"
@model votingsystem.Pages.Shared.ADManageElectionsModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Manage Elections</title>
    <link rel="stylesheet" href="/css/ADManageElections.css">
    <script defer src="/js/ADManageElections.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="wrapper">
        <nav class="sidebar">
            <ul>
                <li>
                    <form method="post" asp-page-handler="RedirectToDashboard">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-chart-line"></i> Dashboard
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToManageElections">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-vote-yea"></i> Manage Elections
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToManageCandidates">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-users"></i> Manage Candidates
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToManageVoters">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-users"></i> Manage Voters
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToVotesRecord">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-list-alt"></i> Votes Record
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToElectionsData">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-chart-line"></i> Elections Data
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" asp-page-handler="RedirectToResults">
                        <button type="submit" class="sidebar-button">
                            <i class="fas fa-chart-bar"></i> Results
                        </button>
                    </form>
                </li>
            </ul>
            <div class="bottom-icon">
                <form method="post" asp-page-handler="LogOut">
                    <button type="submit" class="logout-button">
                        <i class="fas fa-sign-out-alt"></i> Log Out
                    </button>
                </form>
            </div>
        </nav>
        <div class="main-content">
            @if (TempData["Message"] != null)
            {
                <div class="alert">
                    @TempData["Message"]
                </div>
            }

            <header>
                <h1>Manage Elections</h1>
                <input type="text" id="search-candidates" placeholder="Search" />
            </header>

            <section class="create-election-section">
                <h2>@(Model.EditElection != null ? "Edit Election" : "Create Election")</h2>
                <form method="post" asp-page-handler="CreateOrEditElection">
                    <input type="hidden" name="Election.ElectionId" value="@Model.EditElection?.ElectionId" />
                    <div class="form-group">
                        <label for="title">Election Title</label>
                        <input type="text" id="title" name="Election.Title" value="@Model.EditElection?.Title" required>
                    </div>
                    <div class="form-group">
                        <label for="description">Description</label>
                        <textarea id="description" name="Election.Description">@Model.EditElection?.Description</textarea>
                    </div>
                    <div class="row">
                        <select id="department" name="Election.Department" placeholder="Department" required>
                            <option value="" disabled selected>Select Department</option>
                            <option value="CCS"> College of Computing Studies (CCS)</option>
                            <option value="CAS">College of Arts and Sciences (CAS)</option>
                            <option value="CoEng">College of Engineering (CoEng)</option>
                            <option value="CBAA">College of Business Administration and Accountancy (CBAA)</option>
                            <option value="CoEd">College of Education (CoEd)</option>
                            <option value="ALL">All Departments</option>
                        </select>
                    </div>
                    <div class="row">
                        <select id="program" name="Election.Program" placeholder="Program">
                            <option value="" disabled selected>Select Program</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="start-time">Start Time</label>
                        <input type="datetime-local" id="start-time" name="Election.StartTime" value="@Model.EditElection?.StartTime.ToString("yyyy-MM-ddTHH:mm")" required>
                    </div>
                    <div class="form-group">
                        <label for="end-time">End Time</label>
                        <input type="datetime-local" id="end-time" name="Election.EndTime" value="@Model.EditElection?.EndTime.ToString("yyyy-MM-ddTHH:mm")" required>
                    </div>                  
                    <button type="submit" class="primary-button">@(Model.EditElection != null ? "Update Election" : "Create Election")</button>
                </form>
            </section>

            <section class="election-list-section">
                <h2>Elections</h2>
                <div class="table-container">
                    <table id="electionsTable">
                        <thead>
                            <tr>
                                <th>ElectionId</th>
                                <th>Title</th>
                                <th>Description</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Department</th>
                                <th>Program</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var election in Model.Elections)
                            {
                                <tr>
                                    <td>@election.ElectionId</td>
                                    <td>@election.Title</td>
                                    <td>@election.Description</td>
                                    <td>@election.StartTime</td>
                                    <td>@election.EndTime</td>
                                    <td>@election.Department</td>
                                    <td>@election.Program</td>
                                    <td>
                                        @{
                                            var currentTime = DateTime.UtcNow;
                                            var electionEndTime = election.EndTime.ToUniversalTime();
                                            var electionStartTime = election.StartTime.ToUniversalTime();

                                            if (currentTime < electionStartTime)
                                            {
                                                <span class="status upcoming">Upcoming</span>
                                            }
                                            else if (currentTime >= electionStartTime && currentTime < electionEndTime)
                                            {
                                                <span class="status active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="status closed">Closed</span>
                                            }
                                        }
                                    </td>

                                    <td>
                                        <form method="post" asp-page-handler="DeleteElection" asp-route-id="@election.ElectionId" style="display:inline;">
                                            <button type="submit" class="delete-button">Delete</button>
                                        </form>
                                        <form method="get" asp-page-handler="EditElection" asp-route-id="@election.ElectionId" style="display:inline;">
                                            <button type="submit" class="edit-button">Edit</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>           
        </div>
    </div>
</body>
</html>
